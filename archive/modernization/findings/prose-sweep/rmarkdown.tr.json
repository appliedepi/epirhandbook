 "findings": [
  {
   "heading": "Reports with R Markdown",
   "segment_index": "S1.P1",
   "kind": "untrue",
   "en_span": "chapters/rmarkdown.qmd:16-16",
   "tr_span": "chapters/rmarkdown.tr.qmd:15-15",
   "proposition": "The English example of running a report on a subset of data is 'reports for each jurisdiction' (one report per administrative area); the Turkish renders it as 'yargi raporlari', meaning reports of the judiciary.",
   "reader_consequence": "A Turkish reader takes the motivating example to be about court or judicial reporting, and misses the chapter's actual use case of producing one report per geographic or administrative unit, which is exactly what the later 'Dongulu raporlar' (Looping reports) section builds.",
   "confidence": "medium"
  },
  {
   "heading": "Code chunks / Kod parcalari",
   "segment_index": "S16.P1",
   "kind": "missing",
   "en_span": "chapters/rmarkdown.qmd:224-224",
   "tr_span": "chapters/rmarkdown.tr.qmd:226-226",
   "proposition": "The English lists three ways to create a new chunk: typing it out yourself, the keyboard shortcut, or the green 'insert a new code chunk' icon; the Turkish lists only the keyboard shortcut and the icon, dropping 'by typing it out yourself'.",
   "reader_consequence": "A Turkish reader is not told that a chunk is just three back-ticks plus curly brackets that can be typed by hand, so a reader without the RStudio toolbar (or in another editor) is left with no working method.",
   "confidence": "high"
  },
  {
   "heading": "Code chunks / Kod parcalari",
   "segment_index": "S16.P1",
   "kind": "untrue",
   "en_span": "chapters/rmarkdown.qmd:236-238",
   "tr_span": "chapters/rmarkdown.tr.qmd:238-240",
   "proposition": "The English gives the chunk option values as out.width = \"75%\" and out.width = c(\"33%\", \"67%\"), with the percent sign after the number; the Turkish writes them as \"%75\" and c(\"%33\", \"%67\"), with the percent sign before the number.",
   "reader_consequence": "A Turkish reader who copies these values passes an invalid width string to knitr, so the figure is not sized as intended and the reader has no way to see from the text what the correct form is.",
   "confidence": "high"
  },
  {
   "heading": "Formatting HTML files / HTML dosyalarinin formatlanmasi",
   "segment_index": "S42.P1",
   "kind": "untrue",
   "en_span": "chapters/rmarkdown.qmd:736-736",
   "tr_span": "chapters/rmarkdown.tr.qmd:740-740",
   "proposition": "The English names the Bootswatch theme 'journal'; the Turkish names it 'ournal'.",
   "reader_consequence": "A Turkish reader who copies 'ournal' into theme: in the YAML gets a rendering error, because no Bootswatch theme has that name.",
   "confidence": "high"
  }
 ]
