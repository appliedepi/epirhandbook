 "findings": [
  {
   "heading": "Epidemic curves",
   "segment_index": "S1.P2",
   "kind": "untrue",
   "en_span": "chapters/epicurves.qmd:15-15",
   "tr_span": "chapters/epicurves.pt.qmd:15-15",
   "proposition": "The English lists 'time intervals between case generations' among what an epicurve reveals; the Portuguese says 'intervalos temporais entre picos de casos' (time intervals between peaks of cases).",
   "reader_consequence": "A Portuguese reader is told the epicurve reveals the spacing between epidemic peaks, and never learns that it can reveal the generation interval between successive case generations, which is the quantity used to infer serial interval and mode of transmission.",
   "confidence": "high"
  },
  {
   "heading": "Epidemic curves",
   "segment_index": "S1.P2",
   "kind": "added",
   "en_span": "chapters/epicurves.qmd:17-17",
   "tr_span": "chapters/epicurves.pt.qmd:17-20",
   "proposition": "The Portuguese states the page demonstrates two approaches, the incidence2 package (simple commands) and ggplot2; the English states only that the page demonstrates ggplot2.",
   "reader_consequence": "A Portuguese reader expects an incidence2 walkthrough that does not exist anywhere in the chapter, and may install and try incidence2 for a workflow the handbook no longer supports.",
   "confidence": "high"
  },
  {
   "heading": "Epidemic curves",
   "segment_index": "S1.P2",
   "kind": "missing",
   "en_span": "chapters/epicurves.qmd:27-27",
   "tr_span": "chapters/epicurves.pt.qmd:28-29",
   "proposition": "The English states that incidence2 was undergoing revisions, was not stable at the time of writing, and will be re-added to the chapter when stable; the Portuguese omits this entirely.",
   "reader_consequence": "A Portuguese reader has no warning that incidence2 is unstable, so cannot tell why no incidence2 code appears and may build a production report on an API that is in flux.",
   "confidence": "high"
  },
  {
   "heading": "Epicurves with ggplot2",
   "segment_index": "S7.P1",
   "kind": "added",
   "en_span": "chapters/epicurves.qmd:146-146",
   "tr_span": "chapters/epicurves.pt.qmd:147-147",
   "proposition": "The Portuguese opens the sentence with 'Diferente do pacote incidence2' (unlike the incidence2 package), asserting a contrast with incidence2 that the English sentence does not make.",
   "reader_consequence": "A Portuguese reader infers that incidence2 handles time aggregation and date-label intervals automatically, a comparison the handbook never establishes or demonstrates.",
   "confidence": "high"
  },
  {
   "heading": "Weekly epicurve example",
   "segment_index": "S9.P1",
   "kind": "missing",
   "en_span": "chapters/epicurves.qmd:280-280",
   "tr_span": "chapters/epicurves.pt.qmd:283-284",
   "proposition": "The English bullet list states that closed = \"left\" is used in geom_histogram() to ensure the dates are counted in the correct bins; the Portuguese bullet list omits this point.",
   "reader_consequence": "A Portuguese reader building weekly bins never learns that bin membership at a break point must be set with closed = \"left\", and will silently assign cases falling exactly on a Monday to the previous week.",
   "confidence": "high"
  },
  {
   "heading": "One facet with data",
   "segment_index": "S25.P3",
   "kind": "untrue",
   "en_span": "chapters/epicurves.qmd:1149-1149",
   "tr_span": "chapters/epicurves.pt.qmd:1130-1130",
   "proposition": "The English says the facet column moves to the rows side of the equation and the right side is replaced by \".\"; the Portuguese says the left side ('no lado esquerdo') is replaced by \".\".",
   "reader_consequence": "A Portuguese reader following the text writes facet_wrap(.~facet) instead of facet_wrap(facet~.), producing horizontally arranged facets instead of the vertically stacked layout the section is teaching, and contradicting the code shown in the same sentence.",
   "confidence": "high"
  },
  {
   "heading": "Multi-level date labels",
   "segment_index": "S29.P1",
   "kind": "missing",
   "en_span": "chapters/epicurves.qmd:1341-1341",
   "tr_span": "chapters/epicurves.pt.qmd:1314-1314",
   "proposition": "The English states the easiest method is to assign labels = scales::label_date_short() inside scale_x_date(), that it automatically constructs efficient date labels, and that the labels adapt as data expands from days to weeks to months and years; the Portuguese omits this entire method.",
   "reader_consequence": "A Portuguese reader loses the recommended, simplest solution to multi-level date labels and is pushed straight to the far more complex faceting workaround, and the surviving text no longer explains that faceting is only the second option.",
   "confidence": "high"
  },
