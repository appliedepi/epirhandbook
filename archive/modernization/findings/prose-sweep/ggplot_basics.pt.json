 "findings":[
  {"heading":"Rótulos / Labels","segment_index":"S25.P2","kind":"code_mismatch","en_span":"chapters/ggplot_basics.qmd:606-606","tr_span":"chapters/ggplot_basics.pt.qmd:680-680","proposition":"The translation says str_glue() was used in the TITLE assignment; the English says it was used in the CAPTION assignment, and the chunk beside it uses str_glue() only inside caption = .","reader_consequence":"A Portuguese reader looks for str_glue() in the title = argument of the labs() call above, where it does not appear, and may copy the dynamic-date pattern into title = instead of caption = .","confidence":"high"},
  {"heading":"Modifique o tema / Modify theme","segment_index":"S28.P1","kind":"code_mismatch","en_span":"chapters/ggplot_basics.qmd:672-672","tr_span":"chapters/ggplot_basics.pt.qmd:747-747","proposition":"The translation attributes element_text(hjust = 0) to the plot TITLE; the English attributes it to the CAPTION, and the chunk beside it applies hjust = 0 to plot.caption, not to plot.title.","reader_consequence":"A Portuguese reader believes hjust = 0 in the example controls the title and writes plot.title = element_text(hjust = 0) when trying to left-align a caption, producing the wrong element.","confidence":"high"},
  {"heading":"`ggplot()`","segment_index":"S8.P1","kind":"code_mismatch","en_span":"chapters/ggplot_basics.qmd:170-170","tr_span":"chapters/ggplot_basics.pt.qmd:192-192","proposition":"The translation names the ggplot() dataset argument `dados = `; the English names it `data = `, and the chunk beside it writes ggplot(data = linelist).","reader_consequence":"A Portuguese reader who types ggplot(dados = linelist) gets an unused-argument error, because ggplot2 has no argument named dados.","confidence":"medium"},
  {"heading":"Modifique o tema / Modify theme","segment_index":"S28.P2","kind":"untrue","en_span":"chapters/ggplot_basics.qmd:702-702","tr_span":"chapters/ggplot_basics.pt.qmd:778-778","proposition":"The translation describes the `axis.text = element_text()` table row as adjusting x-axis text; the English describes it as adjusting axis text on both axes.","reader_consequence":"The axis.text row and the axis.text.x row now carry the identical description in Portuguese, so a reader cannot tell the two arguments apart and may use axis.text.x when both axes need the change.","confidence":"medium"},
  {"heading":"Fazer gráficos de dados contínuos / Plot continuous data","segment_index":"S31.P1","kind":"added","en_span":"chapters/ggplot_basics.qmd:773-773","tr_span":"chapters/ggplot_basics.pt.qmd:856-856","proposition":"The translation adds a translator's note explaining that 'jitter' means agitated or nervous in English and that the points are spread so they do not overlap; the English has no such note.","reader_consequence":"A Portuguese reader meets an in-text editorial aside in the bullet list of plot types that no other language edition carries; the content is correct but it is not part of the handbook text.","confidence":"high"}
 ]}
