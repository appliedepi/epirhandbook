  "findings": [
    {
      "heading": "Aggregate and summarize / Toplama ve ozetleme",
      "segment_index": "S11.P1",
      "kind": "untrue",
      "en_span": "chapters/heatmaps.qmd:270-270",
      "tr_span": "chapters/heatmaps.tr.qmd:270-270",
      "proposition": "The summary column counts the number of DISTINCT days in the facility-week with reported data; the Turkish says 'ozel' (special/private) days rather than 'benzersiz' (unique), and the chunk beside it computes length(unique(data_date)).",
      "reader_consequence": "A Turkish reader is told n_days_reported counts 'special' days and has no definition of which days those are, so they cannot see that duplicate reports on the same date are collapsed, and may read p_days_reported as a share of some undefined subset of days.",
      "confidence": "medium"
    },
    {
      "heading": "Aggregate and summarize / Toplama ve ozetleme",
      "segment_index": "S11.P7",
      "kind": "missing",
      "en_span": "chapters/heatmaps.qmd:342-342",
      "tr_span": "chapters/heatmaps.tr.qmd:342-342",
      "proposition": "expanded_weeks has a stated number of rows (English renders 'with `r nrow(expanded_weeks)` rows'); the Turkish sentence states only 'Here is expanded_weeks' and gives no row count.",
      "reader_consequence": "The Turkish reader cannot compare the size of the expanded facility-week grid against agg_weeks, which is the whole point of the expand()/right_join() step, so they lose the evidence that rows were added to fill missing facility-weeks.",
      "confidence": "high"
    },
    {
      "heading": "Aggregate and summarize / Toplama ve ozetleme",
      "segment_index": "S11.P8",
      "kind": "missing",
      "en_span": "chapters/heatmaps.qmd:348-348",
      "tr_span": "chapters/heatmaps.tr.qmd:348-348",
      "proposition": "The English states the concrete pre-join row count of agg_weeks via an evaluated inline expression (`r nrow(agg_weeks)`); the Turkish drops the leading 'r', so no number is stated and the literal text 'nrow(agg_weeks)' is shown instead.",
      "reader_consequence": "The Turkish reader sees code text where a count should be, so the before/after row-count comparison that demonstrates what right_join(expanded_weeks) added cannot be made.",
      "confidence": "low"
    }
  ]
