  },
  {
   "heading": "APIs",
   "segment_index": "S31.P1",
   "kind": "untrue",
   "en_span": "chapters/importing.qmd:668-668",
   "tr_span": "chapters/importing.jp.qmd:669-669",
   "proposition": "The English says data may be posted on a website without an API. The Japanese says the same data may be posted on ANOTHER website that needs no API (別のウェブサイトに同じデータが投稿されている可能性).",
   "reader_consequence": "The reader looks for a second, different website instead of first checking whether the site they already have posts the file at a URL that import() can read directly.",
