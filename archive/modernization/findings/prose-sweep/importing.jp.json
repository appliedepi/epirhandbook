  {
   "heading": "RDS files",
   "segment_index": "S39.P1",
   "kind": "untrue",
   "en_span": "chapters/importing.qmd:837-837",
   "tr_span": "chapters/importing.jp.qmd:838-838",
   "proposition": "The English conditions the advice on the receiving GIS team also using R. The Japanese attaches the use of R to the epidemiology team the reader belongs to, and states no condition on the GIS team.",
   "reader_consequence": "The reader sends an .rds file to a GIS team that does not use R, and that team cannot open it. That is the exact failure the English condition exists to prevent.",
