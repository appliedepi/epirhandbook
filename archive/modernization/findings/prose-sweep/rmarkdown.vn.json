 "findings": [
  {
   "heading": "Reports with R Markdown",
   "segment_index": "S1.P1",
   "kind": "untrue",
   "en_span": "chapters/rmarkdown.qmd:12-12",
   "tr_span": "chapters/rmarkdown.vn.qmd:12-12",
   "proposition": "English says R Markdown can generate STATIC or interactive outputs; the Vietnamese says it generates 'ket qua thong ke' (STATISTICAL) or interactive outputs.",
   "reader_consequence": "The Vietnamese reader never learns the static/interactive distinction that the rest of the chapter relies on (the 'Dynamic content' section contrasts a plain knitted document with an interactive HTML one), and instead reads a meaningless claim that outputs are 'statistical'.",
   "confidence": "high"
  },
  {
   "heading": "Install rmarkdown R package",
   "segment_index": "S4.P1",
   "kind": "untrue",
   "en_span": "chapters/rmarkdown.qmd:66-66",
   "tr_span": "chapters/rmarkdown.vn.qmd:66-66",
   "proposition": "English says library() from base R LOADS already-installed packages; the Vietnamese says 'Ban cung co the CAI DAT package voi library()' (you can also INSTALL packages with library()).",
   "reader_consequence": "A Vietnamese reader who has not installed rmarkdown will run library(rmarkdown) expecting it to install the package, get 'there is no package called rmarkdown', and have no idea why, because the sentence just told them library() installs it.",
   "confidence": "high"
  },
  {
   "heading": "Important to know",
   "segment_index": "S6.P1",
   "kind": "untrue",
   "en_span": "chapters/rmarkdown.qmd:94-94",
   "tr_span": "chapters/rmarkdown.vn.qmd:94-94",
   "proposition": "English offers two ALTERNATIVES for referring to files elsewhere ('either need to use the full file path OR use the here package'); the Vietnamese states both are required together ('ban se VUA can su dung CA duong dan tep day du VA su dung package here').",
   "reader_consequence": "The Vietnamese reader believes a full absolute path must be combined with here(), which defeats the whole point of here() and contradicts the example given in the very next sentence, import(here('data.csv')), which uses no full path at all.",
   "confidence": "high"
  },
  {
   "heading": "Option 1: Set parameters within YAML",
   "segment_index": "S32.P2",
   "kind": "code_mismatch",
   "en_span": "chapters/rmarkdown.qmd:516-516",
   "tr_span": "chapters/rmarkdown.vn.qmd:521-521",
   "proposition": "English gives the accessor as `params$hospital`, matching the parameter `hospital` defined in the YAML chunk immediately above; the Vietnamese writes it as `params $ Hospital`, with spaces around $ and a capitalised parameter name.",
   "reader_consequence": "A Vietnamese reader who copies `params $ Hospital` gets NULL (no parameter named Hospital exists in the YAML above), so any downstream filter or title silently uses an empty value rather than 'Central Hospital'.",
   "confidence": "medium"
  },
  {
   "heading": "Formatting HTML files",
   "segment_index": "S42.P1",
   "kind": "untrue",
   "en_span": "chapters/rmarkdown.qmd:738-738",
   "tr_span": "chapters/rmarkdown.vn.qmd:743-743",
   "proposition": "English lists 'haddock' among the supported highlight styles; the Vietnamese lists 'hasdock', which is not a pandoc highlight style.",
   "reader_consequence": "A Vietnamese reader who sets `highlight: hasdock` in the YAML gets a render failure from pandoc, and the handbook gives them no way to see that the name itself is wrong.",
   "confidence": "high"
  }
 ]
