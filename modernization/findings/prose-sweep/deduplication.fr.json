 "findings":[
  {"heading":"Here is the data frame / Voici le tableau de données","segment_index":"S5.P1","kind":"untrue","en_span":"chapters/deduplication.qmd:64-64","tr_span":"chapters/deduplication.fr.qmd:64-64","proposition":"The English places the interactive filter boxes along the TOP of the table (\"the filter boxes along the top\"), matching filter = \"top\" in the adjacent DT::datatable() call; the French says \"au-dessous\" (below the table).","reader_consequence":"A French reader looks underneath the rendered table for filter boxes that are rendered above it, and may conclude the interactive filtering demonstration is broken or absent, so they skip the exercise of reviewing each person's encounters.","confidence":"medium"},
  {"heading":"Keep only unique rows / Garder seulement les lignes uniques","segment_index":"S8.P3","kind":"untrue","en_span":"chapters/deduplication.qmd:186-186","tr_span":"chapters/deduplication.fr.qmd:186-186","proposition":"The English says that unless .keep_all = TRUE is set, all columns not mentioned in distinct() will be DROPPED (removed from the result); the French says they \"seront ignorées\" (will be ignored), which asserts only that they are not used, not that they are removed.","reader_consequence":"A French reader who omits .keep_all = TRUE expects the unmentioned columns still to be present in the returned data frame, and is surprised when downstream code referencing e.g. date or symptoms_ever fails with an unknown-column error.","confidence":"medium"},
  {"heading":"Deduplicate elements in a vector / Dédupliquer les éléments d'un vecteur","segment_index":"S9.P2","kind":"code_mismatch","en_span":"chapters/deduplication.qmd:219-223","tr_span":"chapters/deduplication.fr.qmd:219-223","proposition":"The English tells the reader to use BRACKETS to subset the original vector, matching the adjacent chunk x[duplicated(x)]; the French tells the reader to use \"des parenthèses\" (parentheses), which the adjacent chunk does not use.","reader_consequence":"A French reader following the prose writes x(duplicated(x)) instead of x[duplicated(x)] and gets an \"attempt to apply non-function\" error, and learns the wrong subsetting syntax for every later base R example in the chapter.","confidence":"medium"}
 ]}
