 "findings": [
  {
   "heading": "Loading data into our app",
   "segment_index": "S10.P4",
   "kind": "untrue",
   "en_span": "chapters/shiny_basics.qmd:346-346",
   "tr_span": "chapters/shiny_basics.vn.qmd:346-346",
   "proposition": "The English says the district INPUT may arrive as a character vector with multiple values; the Vietnamese says the `%in%` OPERATOR may arrive as a character vector with multiple values.",
   "reader_consequence": "The Vietnamese reader loses the reason `%in%` is used: that `selectInput(multiple = TRUE)` can deliver several district values at once. They may keep `==` in their own function and get a wrong or erroring filter when two districts are selected.",
   "confidence": "medium"
  },
  {
   "heading": "Adding a facility selector",
   "segment_index": "S16.P7",
   "kind": "untrue",
   "en_span": "chapters/shiny_basics.qmd:1083-1083",
   "tr_span": "chapters/shiny_basics.vn.qmd:1082-1082",
   "proposition": "The English says the widget-update function takes the `inputId` OF the widget to be changed; the Vietnamese says the function THEN CHANGES the `inputId` of the function.",
   "reader_consequence": "The reader understands `updateSelectInput()` as renaming a widget's id, which the adjacent chunk contradicts (`inputId = \"select_facility\"` identifies the target while `choices` is what changes). They may try to rewrite input ids at runtime and break the ui-server link.",
   "confidence": "medium"
  },
  {
   "heading": "Recommended extension packages",
   "segment_index": "S20.P1",
   "kind": "untrue",
   "en_span": "chapters/shiny_basics.qmd:1392-1392",
   "tr_span": "chapters/shiny_basics.vn.qmd:1391-1391",
   "proposition": "The English gives the shinythemes documentation URL as https://rstudio.github.io/shinythemes/; the Vietnamese gives https://rstudio.github.io/shinytheme/ (singular).",
   "reader_consequence": "The Vietnamese reader following the shinythemes link reaches a 404 page and cannot find the theme documentation the sentence promises.",
   "confidence": "medium"
  },
  {
   "heading": "Recommended extension packages",
   "segment_index": "S20.P1",
   "kind": "untrue",
   "en_span": "chapters/shiny_basics.qmd:1390-1390",
   "tr_span": "chapters/shiny_basics.vn.qmd:1389-1389",
   "proposition": "The English gives the shinydashboardPlus URL with its original capitalisation (.../shinydashboardPlus/articles/shinydashboardPlus.html); the Vietnamese gives an all-lowercase path (.../shinydashboardplus/articles/shinydashboardplus.html).",
   "reader_consequence": "GitHub Pages paths are case-sensitive, so the Vietnamese link 404s and the reader cannot reach the shinydashboardPlus article.",
   "confidence": "low"
  },
  {
   "heading": "Loading data into our app",
   "segment_index": "S10.P1",
   "kind": "untrue",
