 "findings": [
  {
   "heading": "KPI Tables",
   "segment_index": "S18.P1",
   "kind": "untrue",
   "en_span": "chapters/contact_tracing.qmd:424-424",
   "tr_span": "chapters/contact_tracing.pt.qmd:421-424",
   "proposition": "The KPI indicator measures contacts notified and quarantined within 24h of elicitation (of being elicited/identified); the Portuguese states within 24h of exposure (\"em ate 24h da exposicao\").",
   "reader_consequence": "A Portuguese reader builds the indicator against the date of exposure rather than the date the contact was elicited, which contradicts the Go.Data numerator shown in the same row (date_of_followup - date_of_reporting) and yields a different, wrong metric.",
   "confidence": "high"
  },
  {
   "heading": "Contacts data",
   "segment_index": "S6.P1",
   "kind": "missing",
   "en_span": "chapters/contact_tracing.qmd:95-95",
   "tr_span": "chapters/contact_tracing.pt.qmd:92-92",
   "proposition": "Only rows with a MISSING admin level 2 value are artificially assigned to \"Djembe\"; the Portuguese bullet drops the missing-value condition.",
   "reader_consequence": "A Portuguese reader can read the step as assigning \"Djembe\" to every row of admin_2_name, and so misreads the replace_na(admin_2_name, \"Djembe\") call in the chunk immediately below and the composition of the maps/plots it feeds.",
   "confidence": "medium"
  },
  {
   "heading": "Contacts per case",
   "segment_index": "S12.P1",
   "kind": "missing",
   "en_span": "chapters/contact_tracing.qmd:244-244",
   "tr_span": "chapters/contact_tracing.pt.qmd:232-233",
   "proposition": "The English also advises the reader to explore contacts linked to multiple cases (\"and explore them too!\"), not only to account for them before plotting; the Portuguese keeps only the accounting instruction.",
   "reader_consequence": "A Portuguese reader adjusts for multi-case contacts before plotting but is not prompted to inspect them, so a data-quality signal in that subgroup goes unexamined.",
   "confidence": "low"
  }
 ]
