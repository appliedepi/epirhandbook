    {
      "heading": "Trazado desde los datos / Plotting from dataset",
      "segment_index": "S13.P4",
      "kind": "untrue",
      "en_span": "chapters/diagrams.qmd:565-565",
      "tr_span": "chapters/diagrams.es.qmd:566-566",
      "proposition": "The English says the new columns IDsource and IDtarget hold the ROW NUMBERS (position) of the source and target nodes; the Spanish says they hold 'los numeros de ruta' (route/path numbers), which is not what match(links$source, nodes$name)-1 returns.",
      "reader_consequence": "A Spanish reader is told the columns contain some kind of route number rather than the row position of each node in the 'nodes' data frame, so the reason for subtracting 1 (to shift 1-based row positions to the 0-based indices networkD3 expects) no longer follows, and the reader cannot reason about the code when adapting it to their own node table.",
      "confidence": "medium"
    },
    {
      "heading": "Sintaxis / Syntax",
      "segment_index": "S7.P1",
      "kind": "untrue",
      "en_span": "chapters/diagrams.qmd:137-137",
      "tr_span": "chapters/diagrams.es.qmd:136-136",
      "proposition": "The English says edge STATEMENTS can be separated with spaces, semicolons or newlines; the Spanish says the edge LABELS ('las etiquetas de las conexiones (edges)') can be so separated.",
      "reader_consequence": "A Spanish reader applies the separator rule to label text rather than to whole edge statements, and may write labels containing bare semicolons or newlines, which is not valid DOT, instead of learning that whole statements such as 'Primary -> Secondary' are what may be separated.",
      "confidence": "low"
    }
