 "findings": [
  {
   "heading": "Reports with R Markdown",
   "segment_index": "S1.P1",
   "kind": "missing",
   "en_span": "chapters/rmarkdown.qmd:14-14",
   "tr_span": "chapters/rmarkdown.jp.qmd:14-14",
   "proposition": "An R Markdown script intersperses R code and text so that the script itself becomes the output document, and can hold narrative text (dynamic to the data), tables, figures, bullets/numbers and bibliographies.",
   "reader_consequence": "The Japanese reader never learns the central idea of the chapter, that the .Rmd script IS the document rather than a script that writes one, and never sees the list of element types a report can contain. The Japanese paragraph in that slot is a second, near-identical restatement of the preceding paragraph, so the reader gets the same sentence twice and none of this.",
   "confidence": "high"
  },
  {
   "heading": "YAML metadata",
   "segment_index": "S8.P2",
   "kind": "code_mismatch",
   "en_span": "chapters/rmarkdown.qmd:138-138",
   "tr_span": "chapters/rmarkdown.jp.qmd:138-138",
   "proposition": "The YAML key demonstrated above that carries in-line R code inside quotes is `date:`.",
   "reader_consequence": "The Japanese text points the reader to a `data: ` entry, which does not exist in the YAML block immediately above (lines 132-136 hold title, author and date). The reader looks for a key that is not there and cannot connect the rule to the worked example.",
   "confidence": "high"
  },
  {
   "heading": "Option 1: Set parameters within YAML",
   "segment_index": "S32.P1",
   "kind": "code_mismatch",
   "en_span": "chapters/rmarkdown.qmd:503-503",
   "tr_span": "chapters/rmarkdown.jp.qmd:502-502",
   "proposition": "The two parameters created in this example are named `date` and `hospital`.",
   "reader_consequence": "The Japanese text names the parameters `data` and `hospital`, but the YAML block beside it (lines 505-513) defines `date: 2021-04-10`, and the rest of the section refers to `params$date`. A reader copying the name from the prose writes `params$data` and gets a NULL value.",
   "confidence": "high"
  },
  {
   "heading": "Tabbed sections",
   "segment_index": "S20.P2",
   "kind": "untrue",
   "en_span": "chapters/rmarkdown.qmd:338-338",
   "tr_span": "chapters/rmarkdown.jp.qmd:337-337",
   "proposition": "Adding `.tabset-pills` gives the tabs a pill-shaped (rounded button) appearance.",
   "reader_consequence": "The Japanese renders 'pilled' as the tabs looking stacked or piled up. A reader expects `.tabset-pills` to change the layout of the tabs, and will not recognise the actual result, which is the same row of tabs drawn as rounded buttons.",
   "confidence": "medium"
  },
  {
   "heading": "Tables (Dynamic content)",
   "segment_index": "S44.P1",
   "kind": "missing",
   "en_span": "chapters/rmarkdown.qmd:769-769",
   "tr_span": "chapters/rmarkdown.jp.qmd:768-768",
   "proposition": "Several packages offer the capability of printing a dynamic data frame with filters and scroll bars.",
   "reader_consequence": "The Japanese reader is left believing DT is the only option for dynamic tables, and will not look for alternatives such as reactable or gt when DT does not suit the report.",
   "confidence": "medium"
  },
  {
   "heading": "Source other files",
   "segment_index": "S23.P1",
   "kind": "untrue",
   "en_span": "chapters/rmarkdown.qmd:372-372",
   "tr_span": "chapters/rmarkdown.jp.qmd:371-371",
   "proposition": "Sourcing other scripts helps when you want to display the final figures (plots) at the beginning of the report.",
   "reader_consequence": "The Japanese reads the English 'figures' as numeric values, so the stated benefit becomes showing final numbers early rather than showing pre-computed plots early. A reader weighing the source() approach evaluates it against the wrong use case.",
